# Credential names that this workspace uses. Real values are entered privately with
#   python scripts/credentials.py set NAME
# and stored in .env.local, which Git ignores. Never write a real value in this file.

# Token for the mineru.net document-processing route, created at https://mineru.net/apiManage/token
MINERU_API_TOKEN=

# API key for literature search with OpenDataLab Sciverse.
# Use only after the researcher confirms the scope of queries sent to this service.
SCIVERSE_API_KEY=
